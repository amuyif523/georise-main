{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    /* TypeScript Strictness */
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    /* Build Output */
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true, // because we run directly with ts-node-dev
    /* Type Checking Performance */
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "prisma/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "esm": true
  }
}
